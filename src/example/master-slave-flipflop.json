RlC1us7Yo":{"id":"n_Vv3RlC1us7Yo","type":"time.clock","position":{"x":190,"y":480},"params":{"periodNs":100,"dutyCycle":50,"startHigh":false}},"n_kBb-qv-kPJyl":{"id":"n_kBb-qv-kPJyl","type":"io.switch","position":{"x":120,"y":480},"label":"Enable Clock","params":{"width":1,"value":1}},"n_NJ4O2S80KaTb":{"id":"n_NJ4O2S80KaTb","type":"scope.logic","position":{"x":830,"y":350},"label":"Oscilloscope","params":{"channels":3,"timeSpanNs":1000,"triggerChannel":-1,"triggerEdge":"rising"}},"n_hMMIkFZXrpCE":{"id":"n_hMMIkFZXrpCE","type":"deco.group","position":{"x":250,"y":170},"params":{"title":"Master","subtitle":"Takes D in on one clock level","color":"blue","style":"filled","fontSize":11,"carry":true,"width":19,"height":23}},"n_cKGa1iPy268q":{"id":"n_cKGa1iPy268q","type":"deco.group","position":{"x":470,"y":170},"params":{"title":"Slave","subtitle":"Passes it on when the clock flips","color":"amber","style":"filled","fontSize":11,"carry":true,"width":19,"height":23}},"n_Kx0L1G3mAFZT":{"id":"n_Kx0L1G3mAFZT","type":"deco.text","position":{"x":830,"y":180},"params":{"text":"## Try it\n1. Turn **Enable Clock** on.\n2. Start the simulation.\n3. Flip **Toggle (D)** as the trace runs.\n\n**Q** does not move the moment you flip D. It waits for the next clock edge, and the scope below shows how long it waited.","format":"markdown","fontSize":12,"align":"left","color":"default","background":"none","width":28,"height":15}},"n_grp_in":{"id":"n_grp_in","type":"deco.group","position":{"x":90,"y":180},"params":{"title":"Input","subtitle":"","color":"gray","style":"filled","fontSize":11,"carry":true,"width":14,"height":18}},"n_grp_out":{"id":"n_grp_out","type":"deco.group","position":{"x":700,"y":200},"params":{"title":"Outputs","subtitle":"","color":"green","style":"filled","fontSize":11,"carry":true,"width":10,"height":18}},"n_grp_clock":{"id":"n_grp_clock","type":"deco.group","position":{"x":90,"y":420},"params":{"title":"Clock","subtitle":"Inverted on the way to the slave, so only one half is ever open","color":"purple","style":"filled","fontSize":11,"carry":true,"width":38,"height":13}},"n_note_how":{"id":"n_note_how","type":"deco.text","position":{"x":830,"y":460},"params":{"text":"## Why two halves\nA single latch is *transparent*: while its clock is high its output follows its input, so a change can race straight through it and back round again.\n\nTwo latches in series, clocked oppositely, are never open at the same time. The master reads D and closes; only then does the slave open and show what the master caught.\n\nOne edge, one new value — which is what makes a flip-flop safe to put in a loop with itself.","format":"markdown","fontSize":12,"align":"left","color":"default","background":"none","width":28,"height":21}}},"wires":{"w_su8F_YhULpdV":{"id":"w_su8F_YhULpdV","from":{"nodeId":"n_eK6iFwxdSgVo","pinId":"out"},"to":{"nodeId":"n_NWWwg_qxWPri","pinId":"in0"}},"w_GIJxQJFpVK4A":{"id":"w_GIJxQJFpVK4A","from":{"nodeId":"n_R7GpWhL8TUNB","pinId":"out"},"to":{"nodeId":"n_Gu7lQuyiE9BE","pinId":"in1"}},"w_1vCF5y2AZA0I":{"id":"w_1vCF5y2AZA0I","from":{"nodeId":"n_dW8RALCVe4BX","pinId":"out"},"to":{"nodeId":"n_R7GpWhL8TUNB","pinId":"in0"}},"w_0Xmn8huJIB2p":{"id":"w_0Xmn8huJIB2p","from":{"nodeId":"n_6ocBy1h1jmTQ","pinId":"out"},"to":{"nodeId":"n_wQUCRzUtvkYa","pinId":"in1"},"waypoints":[{"x":460,"y":350},{"x":460,"y":260}]},"w_WSYW72dqc9Qq":{"id":"w_WSYW72dqc9Qq","from":{"nodeId":"n_Gu7lQuyiE9BE","pinId":"out"},"to":{"nodeId":"n_FdWy-Vb1i12y","pinId":"in1"},"waypoints":[{"x":440,"y":370}]},"w_2TWJuX34a94a":{"id":"w_2TWJuX34a94a","from":{"nodeId":"n_NWWwg_qxWPri","pinId":"out"},"to":{"nodeId":"n_wQUCRzUtvkYa","pinId":"in0"},"waypoints":[{"x":440,"y":240}]},"w_YyZKv43-36iA":{"id":"w_YyZKv43-36iA","from":{"nodeId":"n_wQUCRzUtvkYa","pinId":"out"},"to":{"nodeId":"n_FSsA_dYJYqrk","pinId":"in0"}},"w_77l0nMu4onSM":{"id":"w_77l0nMu4onSM","from":{"nodeId":"n_FdWy-Vb1i12y","pinId":"out"},"to":{"nodeId":"n_FdmfaPzXOyuP","pinId":"in1"}},"w_7DA45-voPubk":{"id":"w